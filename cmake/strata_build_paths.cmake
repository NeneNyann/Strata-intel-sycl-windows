# Keep build-machine paths out of the portable Windows binaries, including __FILE__ strings.
if(WIN32 AND STRATA_PORTABLE AND CMAKE_CXX_COMPILER_ID STREQUAL "IntelLLVM")
  get_filename_component(_strata_source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
  set(_strata_path_maps "${_strata_source}=strata")
  foreach(_dep STRATA_GGML_DIR LLAMA_DIR)
    if(${_dep})
      list(APPEND _strata_path_maps "${${_dep}}=llama.cpp")
    endif()
  endforeach()
  foreach(_env USERPROFILE ONEAPI_ROOT VCToolsInstallDir WindowsSdkDir)
    if(DEFINED ENV{${_env}} AND NOT "$ENV{${_env}}" STREQUAL "")
      list(APPEND _strata_path_maps "$ENV{${_env}}=toolchain")
    endif()
  endforeach()
  foreach(_map IN LISTS _strata_path_maps)
    string(REPLACE "\\" "/" _forward "${_map}")
    string(REPLACE "/" "\\" _backward "${_map}")
    add_compile_options("/clang:-ffile-prefix-map=${_forward}" "/clang:-ffile-prefix-map=${_backward}")
  endforeach()
endif()
